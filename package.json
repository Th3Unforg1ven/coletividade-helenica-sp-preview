{
  "name": "coletividade-helenica-sp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-editorial.mjs",
    "media:variants": "node scripts/generate-archive-variants.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts experiments public/privacy.js eslint.config.js vite.config.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"experiments/**/*.{jsx,css}\" public/privacy.js *.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"experiments/**/*.{jsx,css}\" public/privacy.js *.config.js",
    "test": "node --test scripts/test-editorial.mjs src/content/*.test.js",
    "predev": "node scripts/generate-responsive-manifest.mjs",
    "prebuild": "node scripts/generate-responsive-manifest.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/gfs-didot": "5.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.4",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "prettier": "3.9.10"
  }
}
